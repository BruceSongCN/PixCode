{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BruceSongCN/PixCode/schemas/workspace-manifest.schema.json",
  "title": "PixCode 工作区清单",
  "description": "声明业务工作区身份以及各 Target 普通 Git 仓库的目录、远端和默认分支。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspace", "targets"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "用于编辑器补全和校验的 JSON Schema 路径。"
    },
    "schemaVersion": {
      "const": 1,
      "description": "工作区清单格式版本。"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "当前业务工作区的稳定名称。"
        }
      }
    },
    "targets": {
      "type": "object",
      "description": "Target 标识到普通独立 Git 仓库的映射。",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "repository"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^src/[^/]+$",
            "description": "Target 在工作区内的相对目录。"
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "description": "Target Git 仓库远端地址。"
          },
          "defaultBranch": {
            "type": "string",
            "minLength": 1,
            "description": "首次 bootstrap 时检出的默认分支。"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": {
        "defaultProfile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "兼容旧工作区的单一默认验证 Profile。新工作区应使用 defaultProfiles 按执行模式分别声明。"
        },
        "defaultProfiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local"],
          "properties": {
            "local": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "未创建个人配置时使用的本地快速验证 Profile。"
            },
            "remote": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "开发者明确选择远端执行时使用的远端验证 Profile。"
            }
          }
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/verificationProfile"
          }
        }
      },
      "anyOf": [
        {
          "properties": { "defaultProfile": true },
          "required": ["defaultProfile"]
        },
        {
          "properties": { "defaultProfiles": true },
          "required": ["defaultProfiles"]
        }
      ]
    }
  },
  "$defs": {
    "verificationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "debugMode",
        "databaseIsolation",
        "databaseWrites",
        "commands"
      ],
      "properties": {
        "debugMode": {
          "enum": ["local", "remote"],
          "description": "该 Profile 必须匹配的 PixCode 调试模式。"
        },
        "databaseIsolation": {
          "enum": ["none", "dedicated-container", "shared-instance"],
          "description": "数据库隔离方式。会写数据库的远端验证推荐 dedicated-container。"
        },
        "databaseWrites": {
          "type": "boolean",
          "description": "该 Profile 的集成或回归测试是否会写数据库。"
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inspection",
            "unit"
          ],
          "properties": {
            "provision": { "type": "string", "minLength": 1 },
            "reset": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "minLength": 1 },
            "destroy": { "type": "string", "minLength": 1 },
            "inspection": { "type": "string", "minLength": 1 },
            "quick": {
              "type": "string",
              "minLength": 1,
              "description": "实现阶段最快的确定性反馈入口，宜包含增量构建、静态检查或快速测试。"
            },
            "unit": { "type": "string", "minLength": 1 },
            "focused": {
              "type": "string",
              "minLength": 1,
              "description": "最小可回滚业务闭环入口，宜支持 case、tag 或场景参数。"
            },
            "integration": { "type": "string", "minLength": 1 },
            "deploy": { "type": "string", "minLength": 1 },
            "smoke": { "type": "string", "minLength": 1 },
            "regression": { "type": "string", "minLength": 1 },
            "performance": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "databaseWrites": { "const": true }
            },
            "required": ["databaseWrites"]
          },
          "then": {
            "properties": {
              "commands": {
                "type": "object",
                "properties": {
                  "reset": true,
                  "status": true,
                  "integration": true
                },
                "required": ["reset", "status", "integration"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "databaseIsolation": { "const": "dedicated-container" }
            },
            "required": ["databaseIsolation"]
          },
          "then": {
            "properties": {
              "commands": {
                "type": "object",
                "properties": {
                  "provision": true,
                  "destroy": true
                },
                "required": ["provision", "destroy"]
              }
            }
          }
        }
      ]
    }
  }
}
